{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'customManagers:dockerfileVersions',
    'helpers:pinGitHubActionDigests',
    'github>d4rkfella/home-ops//.renovate/autoMerge.json5',
    'github>d4rkfella/home-ops//.renovate/customManagers.json5',
    'github>d4rkfella/home-ops//.renovate/grafanaDashboards.json5',
    'github>d4rkfella/home-ops//.renovate/groups.json5',
    'github>d4rkfella/home-ops//.renovate/labels.json5',
    'github>d4rkfella/home-ops//.renovate/overrides.json5',
    'github>d4rkfella/home-ops//.renovate/semanticCommits.json5',
    'github>d4rkfella/home-ops//.renovate/talosFactory.json5',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Sofia)',
  ],
  rebaseWhen: "conflicted",
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/resources/**',
  ],
  flux: {
    managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
  },
  helm-values: {
    managerFilePatterns: [
      "/(^|/)values\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helmrelease\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helm-release\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)hr\\.ya?ml(?:\\.j2)?$/",
    ],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: [
      "/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"
    ],
  },
}
