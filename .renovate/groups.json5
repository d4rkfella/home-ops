{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      "prTitle": "chore(deps): update devcontainer dependencies",
      "commitMessageTopic": "devcontainer dependencies",
      groupName: 'devcontainer',
      matchFileNames: [
        '.devcontainer/Dockerfile',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: [
        'Actions Runner Controller Group',
      ],
      groupName: 'actions-runner-controller',
      matchPackageNames: [
        '/gha-runner-scale-set-controller/',
        '/gha-runner-scale-set/',
      ],
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: [
        'Keycloak Group',
      ],
      groupName: 'keycloak',
      matchPackagePatterns: [
        'd4rkfella/keycloak',
        'keycloak/keycloak-k8s-resources',
      ],
      matchDatasources: [
        'github-tags',
        'docker',
      ],
      "matchUpdateTypes": ["major", "minor", "patch"],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: [
        'OpenEBS Group',
      ],
      groupName: 'OpenEBS',
      matchPackageNames: ["/zfs-localpv/", "/csi-node-driver-registrar/", "/csi-resizer/", "/csi-snapshotter/", "/snapshot-controller/", "/csi-provisioner/"],
      matchDatasources: [
        'github-tags',
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 1,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/(^|\\/|:)kubelet$/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Barman Cloud Group",
      group: "barman-cloud",
      matchDatasources: ["docker"],
      matchPackagePatterns: ["/plugin-barman-cloud/", "plugin-barman-cloud-sidecar"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
  ],
}
